{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Список товаров",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Неизвестный товар",
      "method": "POST",
      "path": "/",
      "body": {
        "productId": "nope",
        "playerId": "p1",
        "email": "a@b.ru"
      },
      "expectedStatus": 400,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Проверяет игрока",
      "method": "POST",
      "path": "/",
      "body": {
        "productId": "no-ads",
        "playerId": "!!",
        "email": "a@b.ru"
      },
      "expectedStatus": 400,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Проверяет почту",
      "method": "POST",
      "path": "/",
      "body": {
        "productId": "no-ads",
        "playerId": "p1",
        "email": "bad"
      },
      "expectedStatus": 400,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Статус неизвестного заказа",
      "method": "POST",
      "path": "/",
      "body": {
        "orderId": "game-00000000000000000000000000000000"
      },
      "expectedStatus": 404,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Некорректный номер заказа",
      "method": "POST",
      "path": "/",
      "body": {
        "orderId": "hack"
      },
      "expectedStatus": 400,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Каталог ByteTrace",
      "method": "GET",
      "path": "/?gameId=bytetrace",
      "expectedStatus": 200
    },
    {
      "name": "Неизвестная игра",
      "method": "GET",
      "path": "/?gameId=nope",
      "expectedStatus": 404,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Покупки игрока",
      "method": "GET",
      "path": "/?gameId=bytetrace&playerId=player-42",
      "expectedStatus": 200,
      "expectedBody": {
        "gameId": "bytetrace",
        "playerId": "player-42"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Покупки нового игрока",
      "method": "GET",
      "path": "/?gameId=bytetrace&playerId=brand-new-player-999",
      "expectedStatus": 200,
      "expectedBody": {
        "products": [],
        "noAds": false
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Каталог Масло Кликер",
      "method": "GET",
      "path": "/?gameId=butter-clicker",
      "expectedStatus": 200,
      "expectedBody": {
        "gameId": "butter-clicker"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Каталог Кооператив №6",
      "method": "GET",
      "path": "/?gameId=kooperativ-6",
      "expectedStatus": 200,
      "expectedBody": {
        "gameId": "kooperativ-6"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Подписка на релиз",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "notify-release",
        "gameId": "kooperativ-6",
        "email": "test-subscriber@example.com"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "ok": true
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Статистика подписчиков без кода",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "release-stats",
        "gameId": "kooperativ-6"
      },
      "expectedStatus": 403,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Рассылка без кода запрещена",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "release-send",
        "gameId": "kooperativ-6",
        "subject": "test",
        "message": "test"
      },
      "expectedStatus": 403,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Подписка проверяет почту",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "notify-release",
        "gameId": "kooperativ-6",
        "email": "bad"
      },
      "expectedStatus": 400,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    }
  ]
}