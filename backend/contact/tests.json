{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Пустая заявка отклоняется",
      "method": "POST",
      "path": "/",
      "body": {"name": "", "email": "", "message": ""},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Некорректная почта отклоняется",
      "method": "POST",
      "path": "/",
      "body": {"name": "Иван", "email": "not-an-email", "message": "Привет"},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "GET не поддерживается",
      "method": "GET",
      "path": "/",
      "expectedStatus": 405
    }
  ]
}
